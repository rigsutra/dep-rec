{
  "name": "dep-rec",
  "private": false,
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "author": "Ashish Singh",
  "description": "Recommend the best-fit npm package for a described need, or check any arbitrary package's health/security live — as a CLI or an MCP server for AI assistants.",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AshishPodtech/package_rec.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "npm",
    "mcp",
    "model-context-protocol",
    "cli",
    "dependency",
    "package-recommendation",
    "security"
  ],
  "bin": {
    "dep-rec": "dist/cli.js",
    "dep-rec-mcp-server": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit-*.test.ts",
    "test:corpus": "node --import tsx --test tests/corpus.test.ts",
    "test:cli": "node --import tsx --test tests/cli.test.ts",
    "test:mcp": "node --import tsx --test tests/mcp.test.ts",
    "test:gaps": "node --import tsx --test tests/adversarial-gaps.test.ts",
    "test:review": "node --import tsx --test tests/review-findings.test.ts",
    "seed-db": "tsx src/store/seed.ts",
    "refresh": "tsx src/store/refresh-worker.ts",
    "server": "tsx src/server.ts",
    "stress": "node --import tsx stress/run.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7",
    "@modelcontextprotocol/sdk": "^1.10.0"
  }
}
