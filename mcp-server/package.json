{
  "name": "dep-rec",
  "private": false,
  "version": "0.7.0",
  "type": "module",
  "license": "MIT",
  "author": "Ashish Singh",
  "description": "Stop AI agents installing hallucinated, typosquatted, brand-new or vulnerable npm packages: a Claude Code hook, an MCP server and a CLI that checks packages live against npm and OSV, recommends the best fit for a need, and patches vulnerable dependencies without major upgrades.",
  "engines": {
    "node": ">=18.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/rigsutra/dep-rec.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "npm",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "hook",
    "ai-agent",
    "cli",
    "dependency",
    "dependencies",
    "security",
    "supply-chain",
    "typosquatting",
    "slopsquatting",
    "hallucination",
    "vulnerability",
    "osv",
    "audit",
    "npm-audit-fix",
    "package-recommendation"
  ],
  "bin": {
    "dep-rec": "dist/cli.js",
    "dep-rec-mcp-server": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "test": "node scripts/run-tests.mjs",
    "test:node18": "node scripts/assert-runtime.mjs 18 && npm test",
    "test:node22": "node scripts/assert-runtime.mjs 22 && npm test",
    "test:floor": "npm run build && node scripts/floor-check.mjs",
    "test:unit": "node scripts/run-tests.mjs unit-",
    "test:corpus": "node --import tsx --test tests/corpus.test.ts",
    "test:cli": "node --import tsx --test tests/cli.test.ts",
    "test:mcp": "node --import tsx --test tests/mcp.test.ts",
    "test:gaps": "node --import tsx --test tests/adversarial-gaps.test.ts",
    "test:review": "node --import tsx --test tests/review-findings.test.ts",
    "seed-db": "tsx src/store/seed.ts",
    "refresh": "tsx src/store/refresh-worker.ts",
    "server": "tsx src/server.ts",
    "stress": "node --import tsx stress/run.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@types/node": "^18.19.130",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
