{
  "name": "dep-rec",
  "private": false,
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "author": "Ashish Singh",
  "description": "Recommend the best-fit npm package for a described need, or check any arbitrary package's health/security live — as a CLI or an MCP server for AI assistants.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AshishPodtech/package_rec.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "npm",
    "mcp",
    "model-context-protocol",
    "cli",
    "dependency",
    "package-recommendation",
    "security"
  ],
  "bin": {
    "dep-rec": "dist/cli.js",
    "dep-rec-mcp-server": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "seed-db": "tsx src/store/seed.ts",
    "refresh": "tsx src/store/refresh-worker.ts",
    "server": "tsx src/server.ts",
    "test-client": "tsx src/test-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.24.1"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
