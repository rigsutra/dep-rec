{
  "name": "dep-rec-mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for AI coding assistants: recommend the best-fit npm package for a described need, or check any arbitrary package's health/security live.",
  "bin": {
    "dep-rec-mcp-server": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "sync-data": "node -e \"require('fs').copyFileSync('../stage1-collector/data/scored.json','data/scored.json')\"",
    "server": "tsx src/server.ts",
    "test-client": "tsx src/test-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
