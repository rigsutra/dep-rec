{
  "name": "dep-rec-mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Recommend the best-fit npm package for a described need, or check any arbitrary package's health/security live — as an MCP server for AI assistants, or a plain CLI.",
  "bin": {
    "dep-rec-mcp-server": "dist/server.js",
    "dep-rec": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prepack": "npm run build",
    "seed-db": "tsx src/store/seed.ts",
    "refresh": "tsx src/store/refresh-worker.ts",
    "server": "tsx src/server.ts",
    "test-client": "tsx src/test-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
